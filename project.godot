; Engine configuration file. Edit through the Godot editor or by hand; keep it in version control.

config_version=5

[application]

config/name="era-game"
config/name.web="횃불 지기"
run/main_scene="res://src/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")

[display]

window/size/viewport_width=480
window/size/viewport_height=270
window/size/window_width_override=1440
window/size/window_height_override=810
window/stretch/mode="canvas_items"
window/stretch/scale_mode="integer"

[physics]

common/physics_ticks_per_second=60
common/max_physics_steps_per_frame=5

[rendering]

textures/canvas_textures/default_texture_filter=0
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
