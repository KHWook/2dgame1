{
  "extraKnownMarketplaces": {
    "cursor-plugins": { "source": { "source": "github", "repo": "cursor/plugins" } }
  },
  "enabledPlugins": { "pstack@cursor-plugins": true },
  "permissions": {
    "deny": ["Edit(./tests/golden/**)", "Write(./tests/golden/**)"]
  },
  "hooks": {
    "PostToolUse": [
      { "matcher": "Edit|Write|MultiEdit", "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/verify\" --check --hook" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "\"$CLAUDE_PROJECT_DIR/verify\" --hook", "timeout": 180 }] }
    ]
  }
}
